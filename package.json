{
  "name": "hubatrade",
  "version": "1.0.0",
  "description": "Modern ecommerce platform with vendor, service provider, dispatcher, and customer portals",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "echo 'Server built'",
    "client": "cd client && npm start"
  },
  "keywords": [
    "ecommerce",
    "vendor",
    "marketplace",
    "dispatcher",
    "service-provider"
  ],
  "author": "Hubatrade",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "stripe": "^13.8.0",
    "paystack": "^1.1.0",
    "axios": "^1.5.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "nodemailer": "^6.9.6",
    "cloudinary": "^1.40.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
