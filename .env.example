# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=mongodb://localhost:27017/hubatrade

# JWT Configuration
JWT_SECRET=hubatrade_jwt_secret_2024_secure_key_change_in_production
JWT_EXPIRE=7d

# Paystack Configuration (Test Keys - Replace with your own)
# DO NOT COMMIT REAL PAYSTACK KEYS TO GITHUB
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Email Configuration (Optional - Leave empty to skip email sending)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL
CLIENT_URL=http://localhost:3000

# Admin Settings
ADMIN_EMAIL=admin@hubatrade.com
COMMISSION_RATE=10
